# ==============================================================================
# Database (PostgreSQL with PostGIS and pgvector)
# ==============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lost_found_db

# ==============================================================================
# Cloudflare R2 Object Storage (S3-compatible)
# ==============================================================================
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=lost-found-images

# ==============================================================================
# Google Gemini API
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

# ==============================================================================
# Redis / Arq Background Queue
# ==============================================================================
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Security Secrets
# ==============================================================================
# Secret used for hashing / token validation (min 32 characters)
AUTH_SECRET=generate_with_openssl_rand_hex_32
# Secret shared between Next.js server proxy and FastAPI backend
INTERNAL_API_SECRET=generate_with_openssl_rand_hex_32
